{
  "Version": "1",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["oss:GetObject", "oss:PutObject"],
      "Resource": ["acs:oss:*:*:<your-bucket>/ehpc-benchmark/*"]
    },
    {
      "Effect": "Allow",
      "Action": "oss:ListObjects",
      "Resource": "acs:oss:*:*:<your-bucket>",
      "Condition": {"StringLike": {"oss:Prefix": "ehpc-benchmark/*"}}
    }
  ]
}
