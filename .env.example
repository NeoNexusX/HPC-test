# Copy to .env (git-ignored), fill in, then: chmod 600 .env
# submit_instant.py loads it automatically; variables already exported in the shell take precedence.

# RAM user AccessKey for submitting jobs (not the main account: it cannot call AssumeRole)
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=

# ACR login used by INSTANT to pull the private image (same as the GitHub ACR_USERNAME/ACR_PASSWORD)
ACR_PULL_USERNAME=NeoNexus
ACR_PULL_PASSWORD=

# Local machine: skip probing the ECS metadata service for credentials
ALIBABA_CLOUD_ECS_METADATA_DISABLED=true
